---
import Base from "../../../layouts/Base.astro";
import { FirewallDevicePage } from "../../../views/firewall-device-page";
import { devicesCopy } from "../../../firewall/devices-copy";
import { FIREWALL_LOCALES, type FirewallLocale } from "../../../firewall/locale";
import "../../../styles/firewall-contribute.css";

export function getStaticPaths() {
  return FIREWALL_LOCALES.filter((locale) => locale !== "en" && locale !== "tr").map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as FirewallLocale;
---
<Base title={devicesCopy[locale].title} description={devicesCopy[locale].intro} lang={locale}><FirewallDevicePage locale={locale} client:only="react" /></Base>
