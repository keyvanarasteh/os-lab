# OS / editor
.DS_Store
*.log
*.swp

# Local secrets & profiles (keep .env.example)
**/.env
!**/.env.example
**/.lab-profile
**/config.env
!**/config.env.example
android-lab/lab/.sim-device
# Your declared lab scope (start from console/scope.example.json)
/scope.json
ios-lab/mac/config.env
ios-lab/mac/.sim-device
ios-lab/mac/.appium.pid

# MPT-07 lab-target build output, per-session pentest artifacts and the
# operator-owned local target allowlist (never commit)
ios-lab/mac/pentest/lab-target/build/
ios-lab/artifacts/pentest-frida/
ios-lab/mac/pentest/targets.local.json

# Lat build cache
.lat-build

# Mutable lab state — keep the directory, ignore contents
**/storage/*
!**/storage/.gitkeep
**/shared/*
!**/shared/.gitkeep
**/backups/*
!**/backups/.gitkeep
**/oem/*
!**/oem/.gitkeep
**/artifacts/*
!**/artifacts/.gitkeep
android-lab/lab/apks/*
!android-lab/lab/apks/.gitkeep
android-lab/lab/frida/*
!android-lab/lab/frida/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
lat.md/.cache/
.venv-test

# Private, off-the-record local notes (never committed)
*.local.md
.private/
teached/**/*
# A symlink into the shared cache in worktrees made by scripts/worktree.sh, so no trailing slash
dashboard/node_modules
dashboard/.check-source-pages/
dashboard/test-results/
dashboard/playwright-report/
# Release credentials (Apple signing + notarization). Only the READMEs are tracked.
secrets/*
!secrets/README.md
app/out/
app/src-tauri/resources/tools/uv-*
# CLW-06/08: generated widget build products and Xcode project
app/widget/build/
app/widget/build-gen/
app/widget/OSLabWidgets.xcodeproj/
app/**/*.p8
app/**/*.p12
app/**/*.pfx

# Built content pack (scripts/build-content.py)
dist-content/

# Compiled lab C targets & binaries (PENT-07)
*.exe
*.out
*.o
*.obj
hedef

# Web Lab engine build artifacts (web-lab/browser)
web-lab/browser/target/

# Stage timings written by scripts/run-tests.sh (plan item S)
/test-results/

# Written by scripts/worktree.sh: cache settings and the .venv-test link (plan item I)
.oslab-env
