# OS / editor
.DS_Store
*.log
*.swp

# Local secrets & profiles (keep .env.example)
**/.env
!**/.env.example
**/.lab-profile
**/config.env
!**/config.env.example
android-lab/lab/.sim-device
# Your declared lab scope (start from console/scope.example.json)
/scope.json
ios-lab/mac/config.env
ios-lab/mac/.sim-device
ios-lab/mac/.appium.pid

# Lat build cache
.lat-build

# Mutable lab state — keep the directory, ignore contents
**/storage/*
!**/storage/.gitkeep
**/shared/*
!**/shared/.gitkeep
**/backups/*
!**/backups/.gitkeep
**/oem/*
!**/oem/.gitkeep
**/artifacts/*
!**/artifacts/.gitkeep
android-lab/lab/apks/*
!android-lab/lab/apks/.gitkeep
android-lab/lab/frida/*
!android-lab/lab/frida/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
lat.md/.cache/
.venv-test/

# Private, off-the-record local notes (never committed)
*.local.md
.private/
teached/**/*
dashboard/node_modules/
dashboard/.check-source-pages/
dashboard/test-results/
dashboard/playwright-report/
# Release credentials (Apple signing + notarization). Only the READMEs are tracked.
secrets/*
!secrets/README.md
app/out/
app/src-tauri/resources/tools/uv-*
app/**/*.p8
app/**/*.p12
app/**/*.pfx

# Built content pack (scripts/build-content.py)
dist-content/
