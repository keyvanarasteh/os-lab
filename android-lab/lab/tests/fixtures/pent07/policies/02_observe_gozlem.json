{
  "version": 1,
  "policy_id": "02_observe_gozlem",
  "description": "Read-only observation policy (gozlem.js): inspects onEnter args and onLeave retval without tampering.",
  "target": {
    "source": "android-lab/lab/tests/targets/hedef.c",
    "function": "parola_kontrol"
  },
  "schedule": {
    "iterations": 3,
    "interval_ms": 2000
  },
  "inputs": {
    "parola": "deneme123",
    "yetki_seviyesi": 1
  },
  "rules": [
    {
      "function": "parola_kontrol",
      "onEnter": {
        "observe_args": [
          {
            "index": 0,
            "name": "girilen_parola",
            "type": "utf8"
          },
          {
            "index": 1,
            "name": "yetki_seviyesi",
            "type": "int32"
          }
        ],
        "tamper_args": []
      },
      "onLeave": {
        "observe_retval": true,
        "retval_replace": {
          "enabled": false,
          "value": 0,
          "type": "int32"
        }
      }
    }
  ]
}
