{
  "version": 1,
  "policy_id": "03_onenter_arg_tamper",
  "description": "onEnter argument tampering: replaces arg[0] from deneme123 to gizli123 so parola_kontrol naturally returns 1.",
  "target": {
    "source": "android-lab/lab/tests/targets/hedef.c",
    "function": "parola_kontrol"
  },
  "schedule": {
    "iterations": 3,
    "interval_ms": 2000
  },
  "inputs": {
    "parola": "deneme123",
    "yetki_seviyesi": 1
  },
  "rules": [
    {
      "function": "parola_kontrol",
      "onEnter": {
        "observe_args": [
          {
            "index": 0,
            "name": "girilen_parola",
            "type": "utf8"
          },
          {
            "index": 1,
            "name": "yetki_seviyesi",
            "type": "int32"
          }
        ],
        "tamper_args": [
          {
            "index": 0,
            "name": "girilen_parola",
            "type": "utf8",
            "when_equals": "deneme123",
            "value": "gizli123"
          }
        ]
      },
      "onLeave": {
        "observe_retval": true,
        "retval_replace": {
          "enabled": false,
          "value": 1,
          "type": "int32"
        }
      }
    }
  ]
}
