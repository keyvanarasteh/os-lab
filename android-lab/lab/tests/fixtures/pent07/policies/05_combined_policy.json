{
  "version": 1,
  "policy_id": "05_combined_policy",
  "description": "Combined onEnter argument escalation (yetki_seviyesi 0->5) and onLeave retval.replace (0->1).",
  "target": {
    "source": "android-lab/lab/tests/targets/hedef.c",
    "function": "parola_kontrol"
  },
  "schedule": {
    "iterations": 3,
    "interval_ms": 2000
  },
  "inputs": {
    "parola": "yanlis_parola",
    "yetki_seviyesi": 0
  },
  "rules": [
    {
      "function": "parola_kontrol",
      "onEnter": {
        "observe_args": [
          {
            "index": 0,
            "name": "girilen_parola",
            "type": "utf8"
          },
          {
            "index": 1,
            "name": "yetki_seviyesi",
            "type": "int32"
          }
        ],
        "tamper_args": [
          {
            "index": 1,
            "name": "yetki_seviyesi",
            "type": "int32",
            "when_equals": 0,
            "value": 5
          }
        ]
      },
      "onLeave": {
        "observe_retval": true,
        "retval_replace": {
          "enabled": true,
          "when_equals": 0,
          "value": 1,
          "type": "int32"
        }
      }
    }
  ]
}
