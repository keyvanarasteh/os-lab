{
  "$schema": "./schema.json",
  "version": 1,
  "family": "browser",
  "entries": [
    {
      "id": "browser.chrome.cache",
      "name": "Google Chrome caches",
      "category": "browser",
      "risk": "low",
      "hint": "Generated browser cache data across every local profile.",
      "impact": "The browser rebuilds this data; first page loads may be slower.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "owningProcesses": [
        "Google Chrome",
        "chrome",
        "chrome.exe"
      ],
      "detector": "profile-glob",
      "paths": {
        "macos": [
          "~/Library/Caches/Google/Chrome/*/Cache",
          "~/Library/Application Support/Google/Chrome/*/Code Cache",
          "~/Library/Application Support/Google/Chrome/*/GPUCache"
        ],
        "linux": [
          "${XDG_CACHE_HOME:-~/.cache}/google-chrome/*/Cache",
          "${XDG_CONFIG_HOME:-~/.config}/google-chrome/*/Code Cache",
          "${XDG_CONFIG_HOME:-~/.config}/google-chrome/*/GPUCache"
        ],
        "windows": [
          "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache",
          "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache",
          "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache"
        ]
      }
    },
    {
      "id": "browser.chrome.history",
      "name": "Chrome history",
      "category": "browser",
      "risk": "privacy",
      "hint": "Visited-page history in each Chrome profile.",
      "impact": "Clearing this removes browsing history from those profiles.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "owningProcesses": [
        "Google Chrome",
        "chrome",
        "chrome.exe"
      ],
      "detector": "profile-glob",
      "paths": {
        "macos": [
          "~/Library/Application Support/Google/Chrome/*/History"
        ],
        "linux": [
          "${XDG_CONFIG_HOME:-~/.config}/google-chrome/*/History"
        ],
        "windows": [
          "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\History"
        ]
      }
    },
    {
      "id": "browser.chrome.extension-traces",
