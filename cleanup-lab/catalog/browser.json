        "linux": [
          "${XDG_CONFIG_HOME:-~/.config}/google-chrome/*/Extension State"
        ],
        "windows": [
          "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Extension State"
        ]
      }
    },
