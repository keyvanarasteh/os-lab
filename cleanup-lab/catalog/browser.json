      "risk": "privacy",
      "hint": "Extension telemetry and state in each Chrome profile.",
      "impact": "Extensions may lose local state or regenerate telemetry.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "owningProcesses": [
        "Google Chrome",
        "chrome",
        "chrome.exe"
      ],
      "detector": "profile-glob",
      "paths": {
        "macos": [
          "~/Library/Application Support/Google/Chrome/*/Extension State"
