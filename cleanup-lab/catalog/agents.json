    {
      "id": "agents.gemini",
      "name": "Gemini / Antigravity data",
      "category": "developer",
      "risk": "credentials",
      "hint": "AI agent and editor data under this account: sessions, settings and sign-in state. Measured only.",
      "impact": "Cleaning would lose sessions, settings and sign-ins.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "paths": {
        "macos": [
          "~/.gemini"
        ],
        "linux": [
          "~/.gemini"
        ],
        "windows": [
          "%USERPROFILE%\\.gemini"
        ]
      },
      "cleanable": false,
      "note": "Report-only."
    },
