      "category": "developer",
      "risk": "privacy",
      "hint": "Saved conversations and search indexes of the tool. Sign-in and settings are not included.",
      "impact": "Past conversations are lost and cannot be recovered.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "paths": {
        "macos": [
          "~/.codex/sessions",
          "~/.codex/archived_sessions"
        ],
        "linux": [
          "~/.codex/sessions",
          "~/.codex/archived_sessions"
        ],
        "windows": [
          "%USERPROFILE%\\.codex\\sessions",
          "%USERPROFILE%\\.codex\\archived_sessions"
        ]
      },
      "owningProcesses": [
        "codex"
      ],
      "cleanable": true
    },
    {
      "id": "agents.codex-databases",
      "name": "Codex history and log databases",
      "category": "developer",
      "risk": "privacy",
      "hint": "Thread-history and log databases of the tool. Memories, goals and state are not included.",
      "impact": "Thread history and logs are lost and cannot be recovered.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "paths": {
        "macos": [
          "~/.codex/thread_history_*.sqlite*",
          "~/.codex/logs_*.sqlite*"
        ],
        "linux": [
          "~/.codex/thread_history_*.sqlite*",
          "~/.codex/logs_*.sqlite*"
        ],
        "windows": [
          "%USERPROFILE%\\.codex\\thread_history_*.sqlite*",
          "%USERPROFILE%\\.codex\\logs_*.sqlite*"
        ]
      },
      "owningProcesses": [
        "codex"
      ],
      "cleanable": true,
      "detector": "profile-glob"
    }
