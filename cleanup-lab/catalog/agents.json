          "%USERPROFILE%\\.zcode\\cli",
          "%USERPROFILE%\\.zcode\\v2",
          "%USERPROFILE%\\.zcode\\computer-use",
          "%USERPROFILE%\\.zcode\\tmp"
        ]
      },
      "owningProcesses": [
        "zcode"
      ],
      "cleanable": true,
      "note": "Worktrees are removed with their uncommitted files; push or commit first."
    },
    {
      "id": "agents.gemini-bulk",
      "name": "Gemini / Antigravity binaries and logs",
      "category": "developer",
      "risk": "medium",
      "hint": "Downloaded packages, plugins, caches and scratch worktrees kept by the tool. Sign-in, settings and memories are not included.",
      "impact": "Downloaded binaries are fetched again and logs are recreated. Sign-in and settings are kept.",
