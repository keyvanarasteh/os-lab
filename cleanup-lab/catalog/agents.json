    {
      "id": "agents.codex-bulk",
      "name": "Codex packages and caches",
      "category": "developer",
      "risk": "medium",
      "hint": "Downloaded packages, plugins, caches and scratch worktrees kept by the tool. Sign-in, settings and memories are not included.",
      "impact": "Packages, plugins and caches are downloaded again on the next use. Sign-in and settings are kept.",
      "defaultSelected": false,
      "needsPrivilege": false,
      "paths": {
        "macos": [
          "~/.codex/packages",
          "~/.codex/plugins",
          "~/.codex/cache",
          "~/.codex/generated_images",
          "~/.codex/computer-use",
          "~/.codex/worktrees",
          "~/.codex/attachments"
        ],
        "linux": [
          "~/.codex/packages",
          "~/.codex/plugins",
          "~/.codex/cache",
          "~/.codex/generated_images",
          "~/.codex/computer-use",
          "~/.codex/worktrees",
          "~/.codex/attachments"
        ],
        "windows": [
          "%USERPROFILE%\\.codex\\packages",
          "%USERPROFILE%\\.codex\\plugins",
          "%USERPROFILE%\\.codex\\cache",
          "%USERPROFILE%\\.codex\\generated_images",
          "%USERPROFILE%\\.codex\\computer-use",
          "%USERPROFILE%\\.codex\\worktrees",
          "%USERPROFILE%\\.codex\\attachments"
        ]
      },
      "owningProcesses": [
        "codex"
      ],
      "cleanable": true
    },
    {
      "id": "agents.zcode-bulk",
