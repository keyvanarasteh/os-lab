{
  "version": 1,
  "reviewedOn": "2026-11-26",
  "note": "Codex-specific rules checked against the OpenAI plugin docs on the review date. Claude-only limits and .mcpb are recorded as n/a.",
  "sources": {
    "package": "https://developers.openai.com/plugins/build/plugins",
    "skills": "https://developers.openai.com/plugins/build/skills",
    "desktop": "https://developers.openai.com/plugins/deploy/desktop-only",
    "mcp": "https://modelcontextprotocol.io/specification/2024-11-05"
  },
  "requirements": [
    {"id": "manifest.identity", "area": "manifest", "severity": "error", "usage": "used", "check": "manifest_identity", "source": "package", "rule": "Root plugin.json has name os-lab and a semver version."},
    {"id": "manifest.metadata", "area": "manifest", "severity": "warning", "usage": "used", "check": "manifest_metadata", "source": "package", "rule": "description, author.name, homepage, repository and license are set."},
    {"id": "manifest.extension", "area": "manifest", "severity": "error", "usage": "used", "check": "manifest_extension", "source": "package", "rule": "extensions.com.openai has a contained onboardingSkill and interface display fields."},
    {"id": "marketplace.name", "area": "marketplace", "severity": "error", "usage": "used", "check": "market_name", "source": "package", "rule": "Repo marketplace name is os-lab-local."},
    {"id": "marketplace.entry", "area": "marketplace", "severity": "error", "usage": "used", "check": "market_entry", "source": "package", "rule": "One local plugin entry points at ./plugins/codex/os-lab with AVAILABLE install policy."},
    {"id": "mcp.stdio", "area": "mcp", "severity": "error", "usage": "used", "check": "mcp_stdio", "source": "package", "rule": "mcp.json declares one stdio server with python3 and ${PLUGIN_ROOT}/launcher.py."},
    {"id": "mcp.annotations", "area": "mcp", "severity": "warning", "usage": "used", "check": "mcp_annotations", "source": "mcp", "rule": "Every codex_plugin_* tool declares readOnlyHint."},
    {"id": "mcp.instructions", "area": "mcp", "severity": "warning", "usage": "used", "check": "mcp_instructions", "source": "mcp", "rule": "The shared server initialize instructions mention Codex plugin tools."},
    {"id": "skills.frontmatter", "area": "skills", "severity": "error", "usage": "used", "check": "skills_frontmatter", "source": "skills", "rule": "Every skill has name and description in its first frontmatter block."},
    {"id": "skills.length", "area": "skills", "severity": "warning", "usage": "used", "check": "skills_length", "source": "skills", "rule": "Each SKILL.md stays under 500 lines."},
    {"id": "skills.generated", "area": "skills", "severity": "error", "usage": "used", "check": "skills_generated", "source": "skills", "rule": "The ten packaged lab skills match console/mcp_skills/ (run scripts/codex-plugin.py build)."},
    {"id": "cache.contained", "area": "cache", "severity": "error", "usage": "used", "check": "cache_contained", "source": "package", "rule": "No packaged symlink escapes the plugin root."},
    {"id": "cli.available", "area": "cli", "severity": "warning", "usage": "used", "check": "cli_available", "source": "package", "rule": "Codex CLI is on PATH when lifecycle commands are used."},
    {"id": "distribution.readme", "area": "distribution", "severity": "warning", "usage": "used", "check": "readme", "source": "package", "rule": "The package has a README of at least 40 words and a LICENSE."},
    {"id": "desktop.local", "area": "desktop", "severity": "info", "usage": "used", "check": "manual", "source": "desktop", "rule": "Local stdio plugin is tested in a desktop client."},
    {"id": "desktop.mcpb", "area": "desktop", "severity": "info", "usage": "n/a", "check": "n/a", "source": "desktop", "rule": "Claude Desktop .mcpb is not a Codex package format."},
    {"id": "hooks.lifecycle", "area": "hooks", "severity": "info", "usage": "n/a", "check": "n/a", "source": "package", "rule": "No Codex lifecycle hooks until a live client proves support."},
    {"id": "config.user-placeholders", "area": "settings", "severity": "info", "usage": "n/a", "check": "n/a", "source": "package", "rule": "Claude ${user_config.*} placeholders are not used; Codex uses OSLAB_ROOT and marketplace discovery."}
  ]
}
