# Export these variables before invoking labctl web / make, or set them in the caller.
# The launcher never evaluates a shell .env file.

# Port of the engine's loopback control API (default 5077).
# WEBLAB_ENGINE_PORT=5077

# Engine data root for per-profile web storage and engine logs.
# Defaults to <repo>/web-lab/storage.
# WEBLAB_DATA_DIR=/absolute/path/to/private/web-lab-storage
